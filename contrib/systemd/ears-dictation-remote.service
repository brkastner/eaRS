[Unit]
Description=eaRS dictation client (connects to remote server with LLM correction)
After=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %h/.local/state/ears
# Configure these for your setup:
# EARS_SERVER_URL - WebSocket URL of remote ears-server
# EARS_OLLAMA_URL - Ollama API endpoint for LLM correction
# EARS_OLLAMA_MODEL - Model to use (default: qwen2.5:7b)
Environment=EARS_SERVER_URL=ws://desktop:8765
Environment=EARS_OLLAMA_URL=http://desktop:11434
Environment=EARS_OLLAMA_MODEL=qwen2.5:7b
ExecStart=%h/.cargo/bin/ears-dictation --preview
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.local/state/ears/dictation.log
StandardError=append:%h/.local/state/ears/dictation.log

[Install]
WantedBy=default.target
