[Unit]
Description=eaRS speech-to-text server (remote access via Tailscale)
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %h/.local/state/ears
ExecStart=%h/.cargo/bin/ears-server --engine parakeet --parakeet-noise-gate-rms 0 --bind 0.0.0.0:8765
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.local/state/ears/server.log
StandardError=append:%h/.local/state/ears/server.log

[Install]
WantedBy=default.target
